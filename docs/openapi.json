{
  "openapi": "3.0.3",
  "info": {
    "title": "Luxurious Selection",
    "version": "1.0.0",
    "description": "Public, read-only Phase 1 exhibition API. Curation is a bounded editorial snapshot."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1"
    }
  ],
  "paths": {
    "/exhibitions": {
      "get": {
        "operationId": "listExhibitions",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "links",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Exhibition"
                      }
                    },
                    "links": {
                      "$ref": "#/components/schemas/PaginationLinks"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "RFC 9457 error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24,
              "default": 12
            }
          }
        ]
      }
    },
    "/collections": {
      "get": {
        "operationId": "listCollections",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "links",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Collection"
                      }
                    },
                    "links": {
                      "$ref": "#/components/schemas/PaginationLinks"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "RFC 9457 error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24,
              "default": 12
            }
          }
        ]
      }
    },
    "/exhibitions/{slug}": {
      "get": {
        "operationId": "getExhibition",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Exhibition"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "RFC 9457 error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ]
      }
    },
    "/home/curation": {
      "get": {
        "operationId": "getCuration",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Curation"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "RFC 9457 error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Health"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "RFC 9457 error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Readiness"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "RFC 9457 error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LocalizedText": {
        "type": "object",
        "required": [
          "en",
          "ar"
        ],
        "properties": {
          "en": {
            "type": "string"
          },
          "ar": {
            "type": "string"
          }
        }
      },
      "Media": {
        "type": "object",
        "required": [
          "id",
          "url",
          "alt",
          "width",
          "height",
          "credit",
          "source_url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "alt": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "credit": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Photographer": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "bio"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "bio": {
            "$ref": "#/components/schemas/LocalizedText"
          }
        }
      },
      "Edition": {
        "type": "object",
        "required": [
          "id",
          "label",
          "is_limited",
          "total"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "is_limited": {
            "type": "boolean"
          },
          "total": {
            "type": "integer",
            "nullable": true,
            "minimum": 1
          }
        }
      },
      "Artwork": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "story",
          "published_at",
          "photographer",
          "media",
          "editions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "story": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "photographer": {
            "$ref": "#/components/schemas/Photographer"
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Media"
            }
          },
          "editions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Edition"
            }
          }
        }
      },
      "Exhibition": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "subtitle",
          "hero_artwork"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "subtitle": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "hero_artwork": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Artwork"
              }
            ],
            "nullable": true
          }
        }
      },
      "Collection": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "atmosphere"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "atmosphere": {
            "type": "string",
            "enum": [
              "atmospheric",
              "geometric",
              "expansive",
              "monochrome"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "request_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "nullable": true
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "PaginationLinks": {
        "type": "object",
        "required": [
          "first",
          "last",
          "prev",
          "next"
        ],
        "properties": {
          "first": {
            "type": "string",
            "nullable": true
          },
          "last": {
            "type": "string",
            "nullable": true
          },
          "prev": {
            "type": "string",
            "nullable": true
          },
          "next": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "required": [
          "current_page",
          "from",
          "last_page",
          "path",
          "per_page",
          "to",
          "total",
          "links"
        ],
        "properties": {
          "current_page": {
            "type": "integer"
          },
          "from": {
            "type": "integer",
            "nullable": true
          },
          "last_page": {
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "per_page": {
            "type": "integer"
          },
          "to": {
            "type": "integer",
            "nullable": true
          },
          "total": {
            "type": "integer"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "label",
                "active"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "nullable": true
                },
                "label": {
                  "type": "string"
                },
                "active": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "Curation": {
        "type": "object",
        "required": [
          "current_exhibitions",
          "curators_selection",
          "new_works",
          "featured_photographer",
          "limited_editions",
          "collections",
          "section_limit"
        ],
        "properties": {
          "current_exhibitions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Exhibition"
            },
            "maxItems": 6
          },
          "curators_selection": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Artwork"
            },
            "maxItems": 6
          },
          "new_works": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Artwork"
            },
            "maxItems": 6
          },
          "featured_photographer": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Photographer"
              }
            ],
            "nullable": true
          },
          "limited_editions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Artwork"
            },
            "maxItems": 6
          },
          "collections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Collection"
            },
            "maxItems": 6
          },
          "section_limit": {
            "type": "integer",
            "enum": [
              6
            ]
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "service",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "luxurious-selection"
            ]
          },
          "version": {
            "type": "string",
            "enum": [
              "v1"
            ]
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          }
        }
      }
    }
  }
}
